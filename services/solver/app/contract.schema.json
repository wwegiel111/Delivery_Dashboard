            "unload_slots": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "release_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deadline_slot": {
              "anyOf": [
