        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "crew": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "shift": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "start_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
