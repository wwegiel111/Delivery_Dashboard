      },
      "slot_minutes": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "horizon_slots": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "time_limit_s": {
        "default": 20,
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 600
      },
      "docks": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "crews": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "dock_setup_slots": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "buffer_capacity": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "putaway_per_slot": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "closed_slots": {
        "default": [],
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "latest_arrival_slot": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "putaway_deadline_slot": {
        "default": null,
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "shifts": {
        "default": [],
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "breaks_per_shift": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
