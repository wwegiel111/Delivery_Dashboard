      "break_slots": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "break_edge_slots": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "break_gap_slots": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "weights": {
        "default": {},
        "type": "object",
        "properties": {
          "tardiness": {
            "default": 1000,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "makespan": {
            "default": 50,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "flow": {
            "default": 5,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "buffer": {
            "default": 10,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
